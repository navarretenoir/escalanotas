#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
D = $(CURDIR)/debian/escala-notas

%:
	dh $@

override_dh_auto_build:
	rm -f desktop/escala-notas; make -C desktop UI_DIR=/usr/share/escala-notas/ui EXTRA_CFLAGS="$(shell dpkg-buildflags --get CFLAGS) $(shell dpkg-buildflags --get CPPFLAGS) $(shell dpkg-buildflags --get LDFLAGS)"

override_dh_auto_install:
	install -Dm755 desktop/escala-notas "$(D)/usr/bin/escala-notas"
	install -d "$(D)/usr/share/escala-notas"; cp -r ui "$(D)/usr/share/escala-notas/"; rm -f "$(D)/usr/share/escala-notas/ui/"*.bak*
	install -Dm644 linux/io.github.navarretenoir.EscalaNotas.desktop "$(D)/usr/share/applications/io.github.navarretenoir.EscalaNotas.desktop"
	install -Dm644 linux/io.github.navarretenoir.EscalaNotas.metainfo.xml "$(D)/usr/share/metainfo/io.github.navarretenoir.EscalaNotas.metainfo.xml"
	install -Dm644 linux/io.github.navarretenoir.EscalaNotas.svg "$(D)/usr/share/icons/hicolor/scalable/apps/io.github.navarretenoir.EscalaNotas.svg"

override_dh_auto_clean:
	-$(MAKE) -C desktop clean
